# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/medconnect
# Atlas:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/medconnect
MONGO_URI=mongodb://127.0.0.1:27017/medconnect

# JWT secret - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
